model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["A Level","School Sort","Age Group Sort","Day_10","Term Sort"]

annotation PBI_ProTooling = ["DevMode"]

ref table 'A Level'
ref table 'School Sort'
ref table 'Age Group Sort'
ref table Day_10
ref table 'Term Sort'

ref cultureInfo en-US

